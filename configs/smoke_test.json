{
  "experiment_name": "smoke_test",
  "output_dir": "experiments/smoke_test",
  "seed": 0,

  "model": {
    "hidden_dim": 32,
    "vector_dim": 16,
    "n_layers": 2,
    "cutoff": 5.0,
    "multitask": true,
    "task_dims": {"energy": 1, "homo_lumo_gap": 1}
  },

  "data": {
    "datasets": [{"name": "synthetic", "n_samples": 200}],
    "num_workers": 0
  },

  "training": {
    "epochs": 3,
    "batch_size": 16,
    "learning_rate": 0.001,
    "gradient_clip": 1.0,
    "save_frequency": 0
  },

  "loss": {
    "criterion": "mae",
    "weights": {"energy": 1.0, "homo_lumo_gap": 0.5, "forces": 0.5}
  }
}
