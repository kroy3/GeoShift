{
  "experiment_name": "cross_domain",
  "output_dir": "experiments/cross_domain",
  "seed": 42,
  "deterministic": true,

  "model": {
    "hidden_dim": 128,
    "vector_dim": 64,
    "n_layers": 5,
    "cutoff": 5.0,
    "readout": "mean",
    "multitask": true,
    "task_dims": {"energy": 1, "homo_lumo_gap": 1}
  },

  "data": {
    "data_dir": "data",
    "datasets": [
      {"name": "qm9", "max_samples": 50000},
      {"name": "md17:aspirin", "max_samples": 1250},
      {"name": "md17:benzene", "max_samples": 1250},
      {"name": "md17:ethanol", "max_samples": 1250},
      {"name": "md17:malonaldehyde", "max_samples": 1250},
      {"name": "ani1x", "max_samples": 50000}
    ],
    "dataset_weights": {
      "qm9": 0.4,
      "md17:aspirin": 0.075,
      "md17:benzene": 0.075,
      "md17:ethanol": 0.075,
      "md17:malonaldehyde": 0.075,
      "ani1x": 0.3
    },
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1,
    "energy_reference": "linear_fit",
    "num_workers": 4
  },

  "training": {
    "epochs": 100,
    "batch_size": 32,
    "learning_rate": 0.001,
    "weight_decay": 1e-5,
    "gradient_clip": 1.0,
    "scheduler": {"type": "reduce_on_plateau", "factor": 0.5, "patience": 10, "min_lr": 1e-6},
    "early_stopping_patience": 20,
    "use_amp": false,
    "save_frequency": 10
  },

  "loss": {
    "criterion": "mae",
    "weights": {"energy": 1.0, "homo_lumo_gap": 0.5, "forces": 0.5}
  },

  "logging": {"tensorboard": true}
}
