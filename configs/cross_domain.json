{
  "experiment_name": "cross_domain",
  "output_dir": "experiments/cross_domain",
  "seed": 42,
  "deterministic": true,

  "model": {
    "hidden_dim": 128,
    "vector_dim": 64,
    "n_layers": 5,
    "cutoff": 5.0,
    "readout": "sum",
    "multitask": true,
    "task_dims": {"energy": 1}
  },

  "data": {
    "data_dir": "data",
    "datasets": [
      {"name": "qm9", "max_train_samples": 50000},
      {"name": "md17:aspirin", "max_train_samples": 1000, "max_val_samples": 1000, "max_test_samples": 1000},
      {"name": "md17:benzene", "max_train_samples": 1000, "max_val_samples": 1000, "max_test_samples": 1000},
      {"name": "md17:ethanol", "max_train_samples": 1000, "max_val_samples": 1000, "max_test_samples": 1000},
      {"name": "md17:malonaldehyde", "max_train_samples": 1000, "max_val_samples": 1000, "max_test_samples": 1000}
    ],
    "sampling_temperature": 0.5,
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1,
    "energy_reference": "linear_fit",
    "num_workers": 4
  },

  "training": {
    "epochs": 100,
    "batch_size": 16,
    "gradient_accumulation_steps": 4,
    "learning_rate": 0.001,
    "weight_decay": 1e-5,
    "gradient_clip": 1.0,
    "scheduler": {"type": "warmup_cosine", "warmup_epochs": 5, "min_lr": 1e-6},
    "early_stopping_patience": 10,
    "use_amp": true,
    "save_frequency": 10
  },

  "loss": {
    "criterion": "mae",
    "task_weighting": "gradient",
    "weights": {"energy": 1.0, "forces": 1.0}
  },

  "logging": {"tensorboard": true}
}
