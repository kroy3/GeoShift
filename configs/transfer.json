{
  "experiment_name": "transfer",
  "output_dir": "experiments/transfer",
  "seed": 42,
  "deterministic": true,

  "model": {
    "hidden_dim": 128,
    "vector_dim": 64,
    "n_layers": 5,
    "cutoff": 5.0,
    "readout": "mean",
    "multitask": true,
    "task_dims": {"energy": 1}
  },

  "transfer": {
    "pretrained_checkpoint": "experiments/cross_domain/best_model.pt"
  },

  "data": {
    "data_dir": "data",
    "datasets": ["rmd17:aspirin"],
    "max_train_samples": 1000,
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1,
    "energy_reference": "linear_fit",
    "num_workers": 4
  },

  "training": {
    "epochs": 50,
    "batch_size": 32,
    "learning_rate": 0.0001,
    "weight_decay": 1e-5,
    "gradient_clip": 1.0,
    "freeze_backbone_epochs": 10,
    "scheduler": {"type": "reduce_on_plateau", "factor": 0.5, "patience": 5, "min_lr": 1e-7},
    "early_stopping_patience": 15,
    "use_amp": false,
    "save_frequency": 5
  },

  "loss": {
    "criterion": "mae",
    "weights": {"energy": 1.0}
  },

  "logging": {"tensorboard": true}
}
