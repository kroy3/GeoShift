{
  "experiment_name": "single_domain",
  "output_dir": "experiments/single_domain",
  "seed": 42,
  "deterministic": true,

  "model": {
    "hidden_dim": 128,
    "vector_dim": 64,
    "n_layers": 5,
    "cutoff": 5.0,
    "readout": "mean",
    "multitask": false
  },

  "data": {
    "data_dir": "data",
    "datasets": [{"name": "qm9", "max_samples": 50000}],
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1,
    "energy_reference": "linear_fit",
    "num_workers": 4
  },

  "training": {
    "epochs": 100,
    "batch_size": 32,
    "learning_rate": 0.001,
    "weight_decay": 1e-5,
    "gradient_clip": 1.0,
    "scheduler": {"type": "reduce_on_plateau", "factor": 0.5, "patience": 10, "min_lr": 1e-6},
    "early_stopping_patience": 20,
    "use_amp": false,
    "save_frequency": 10
  },

  "loss": {
    "criterion": "mae",
    "weights": {"energy": 1.0}
  },

  "logging": {"tensorboard": true}
}
